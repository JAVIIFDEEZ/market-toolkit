flowchart TB
    usuario(["Usuario: tickers o nombres<br/>(desde_nombres) + fechas"])

    subgraph fuentes["Fuentes externas"]
        direction LR
        yahoo[("Yahoo Finance<br/>acciones · índices · ETF")]
        polygon[("Polygon / Massive<br/>acciones")]
        av[("Alpha Vantage<br/>oro · plata · Brent")]
        fred[("FRED / ALFRED<br/>series macro")]
    end

    subgraph ingesta["1 · Ingesta (providers)"]
        direction LR
        validar_tk["_validar_input()<br/>¿existe y es de un tipo admitido?"]
        download["download()<br/>cierres ajustados<br/>índice sin zona horaria"]
        limpiar["limpiar_serie()<br/>orden · duplicados · inf<br/>negativos · NaN"]
    end

    subgraph modelos["2 · Modelos (series)"]
        direction LR
        validacion{"validation<br/>¿serie válida?"}
        fs["FinancialSeries<br/>estadísticos automáticos"]
        ms["MacroSeries<br/>media y desviación del nivel"]
        error["DataValidationError /<br/>InsufficientDataError"]
    end

    pesos(["Usuario: DataFrame de pesos<br/>(una fila por rebalanceo)"])

    subgraph cartera["3 · Cartera (Portfolio)"]
        direction LR
        sin_indices{"¿algún índice?"}
        juntar["juntar_series()<br/>alineación temporal<br/>+ conversión a USD"]
        validar_p["validar pesos<br/>suman 1 · uno por activo"]
        deriva["_calcular_pesos_activos()<br/>deriva entre rebalanceos"]
        stats["_rendimientos_cartera()<br/>rentabilidad y volatilidad"]
    end

    subgraph simulacion["4 · Simulación (simulation)"]
        direction LR
        mc["MonteCarlo<br/>normal · t de Student · bootstrap"]
        res["percentiles · VaR · CVaR<br/>probabilidad de pérdida"]
    end

    subgraph salida["5 · Resultados"]
        direction LR
        resumen["resumen()"]
        md["report()<br/>Markdown o HTML: métricas, benchmark,<br/>diagnósticos y fortalezas"]
        plots["plots_report()<br/>6 gráficos"]
        graficos["graficar() /<br/>guardar_graficos()"]
    end

    usuario --> validar_tk
    yahoo --> download
    polygon --> download
    av --> download
    fred --> download
    validar_tk --> download --> limpiar --> validacion
    validacion -- "sí, precios" --> fs
    validacion -- "sí, macro" --> ms
    validacion -- "no" --> error
    fs --> sin_indices
    sin_indices -- "sí: usar su ETF" --> error
    sin_indices -- "no" --> juntar
    pesos --> validar_p
    juntar --> validar_p --> deriva --> stats
    stats --> resumen
    stats --> md
    stats --> plots
    ms -. "tipo libre de riesgo" .-> md
    fs -. "índice de referencia" .-> md
    mc -. "comparativa de distribuciones" .-> md
    stats --> mc
    fs -- "un activo" --> mc
    mc --> res --> graficos
