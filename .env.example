# Copia este fichero como .env y rellena las claves que tengas.
# Ninguna es obligatoria: Yahoo Finance funciona sin clave.
# Si falta una clave, el proveedor correspondiente la pide por pantalla al crearse.

# Polygon (Massive): PolygonProvider
POLYGON_API_KEY=

# Alpha Vantage: AlphaVantageProvider (oro, plata y Brent)
ALPHAVANTAGE_API_KEY=

# FRED / ALFRED: MacroProvider
FRED_API_KEY=
